{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen ISAC catalogue and standards authority metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "retrieved_at",
    "scope",
    "catalogue",
    "auxiliary_references",
    "standardization"
  ],
  "properties": {
    "$schema": {
      "const": "./authority-metadata.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "retrieved_at": {
      "$ref": "#/$defs/date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_rows",
        "unique_catalogue_dois",
        "auxiliary_reference_dois",
        "unique_tracked_dois",
        "structured_citation_records",
        "standardization_rows"
      ],
      "properties": {
        "catalogue_rows": {
          "const": 66
        },
        "unique_catalogue_dois": {
          "const": 54
        },
        "auxiliary_reference_dois": {
          "const": 6
        },
        "unique_tracked_dois": {
          "const": 60
        },
        "structured_citation_records": {
          "const": 76
        },
        "standardization_rows": {
          "const": 12
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "authority_url",
        "retrieval_method",
        "records"
      ],
      "properties": {
        "authority": {
          "const": "Crossref REST API publisher-deposited metadata"
        },
        "authority_url": {
          "const": "https://www.crossref.org/"
        },
        "retrieval_method": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "minItems": 54,
          "maxItems": 54,
          "items": {
            "$ref": "#/$defs/catalogue_record"
          }
        }
      }
    },
    "auxiliary_references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "scope_note",
        "records"
      ],
      "properties": {
        "authority": {
          "const": "Crossref REST API publisher-deposited metadata"
        },
        "scope_note": {
          "const": "Tracked DOI references outside the 66-row topical catalogue, including code citations and formal early access"
        },
        "records": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/catalogue_record"
          }
        }
      }
    },
    "standardization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "records"
      ],
      "properties": {
        "authority": {
          "const": "Official standards-body records, kept separate from Crossref"
        },
        "records": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/standard_record"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given",
        "family",
        "display"
      ],
      "properties": {
        "given": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogue_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doi",
        "doi_url",
        "title",
        "authors",
        "venue",
        "year",
        "volume",
        "issue",
        "pages",
        "article_number",
        "publisher",
        "source_type",
        "source_url",
        "authority_record_updated_at"
      ],
      "properties": {
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:a-z0-9]+$"
        },
        "doi_url": {
          "type": "string",
          "pattern": "^https:\\x2f\\x2fdoi\\.org/10\\."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "venue": {
          "$ref": "#/$defs/nullable_string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "volume": {
          "$ref": "#/$defs/nullable_string"
        },
        "issue": {
          "$ref": "#/$defs/nullable_string"
        },
        "pages": {
          "$ref": "#/$defs/nullable_string"
        },
        "article_number": {
          "$ref": "#/$defs/nullable_string"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "journal-article",
            "monograph"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https:\\x2f\\x2fapi\\.crossref\\.org/works/10\\."
        },
        "authority_record_updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      }
    },
    "standard_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "authority",
        "identifier",
        "title",
        "display_title",
        "status",
        "maturity",
        "official_url",
        "as_of",
        "evidence_scope"
      ],
      "properties": {
        "organization": {
          "enum": [
            "IEEE",
            "3GPP",
            "ITU-R",
            "ETSI"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "display_title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "enum": [
            "published-active-standard",
            "normative-technical-specification-under-change-control",
            "study-report-under-change-control",
            "draft-technical-specification",
            "in-force-recommendation",
            "pre-standardization-group",
            "published-group-report",
            "active-draft-project"
          ]
        },
        "official_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "evidence_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
